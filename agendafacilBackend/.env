# Configuração de Banco de Dados
# SQLite (recomendado para desenvolvimento)
DATABASE_URL=sqlite:./agendafacil.db

# Para MySQL local (descomente se usar MySQL)
# DATABASE_URL=mysql://root:@localhost:3306/agendafacil

# Para PostgreSQL (descomente se usar PostgreSQL)
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/agendafacil

# Porta do servidor
PORT=3000

# Configuração de Email (para "Esqueci a Senha")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-gmail
SMTP_FROM=seu-email@gmail.com
